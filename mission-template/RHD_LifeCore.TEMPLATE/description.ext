/*
    RHD - LifeCore | Mission Configuration
    Author: LT. Toad
    ---------------------------------------------------------------------------
    Mission source is separate from the RHD addon source:
      - Mission files: this file, initServer.sqf, initPlayerLocal.sqf, core/, assets/
      - Mod files: addons/rhd_lifecore/ and addons/rhd_clothing/

    SETUP
    -----
    1. Build/install the @RHD-LifeCore addon.
    2. Ensure CBA_A3 and cTab+ are loaded.
    3. In 3DEN place ONE RHD Life RP Systems module.
    4. Optionally place ONE RHD Antistasi Ultimate Bridge module when A3A is installed.
    5. Place RHD map locations/markers in Eden.
    6. Edit core/fn_init.sqf for server configuration.

    Do not hand-edit mission.sqm. Eden owns the mission layout.
    ---------------------------------------------------------------------------
*/

author = "LT. Toad";
onLoadName = "RHD - LifeCore";
onLoadMission = "RHD - LifeCore | Life RP";
overviewText = "RHD - LifeCore | Life RP | Jobs • Economy • Crime • Opportunity";
overviewPicture = "assets\\branding\\RHDLifeCore.jpg";
loadScreen = "assets\\branding\\RHDLifeCore.jpg";

class Header
{
    gameType = Coop;
    minPlayers = 1;
    maxPlayers = 64;
};

respawn = 3;
respawnOnStart = -1;
respawnDelay = 5;
respawnTemplates[] = {"MenuPosition"};
joinUnassigned = 1;

// ============================================================================
// OPTIONAL ANTISTASI COMPATIBILITY
// ============================================================================
// A3A owns its campaign state when the optional RHD bridge is enabled.
// Keeping the class here is harmless in standalone missions and preserves
// compatibility with Antistasi Ultimate's mission-side version/mapInfo checks.
class A3A
{
    version[] = {11,9,12};

    class mapInfo
    {
        class generic
        {
            climate = "temperate";
            antennas[] = {};
            antennasBlacklistIndex[] = {};
            banks[] = {};
            fuelStationTypes[] = {
                "Land_FuelStation_Feed_F",
                "Land_fs_feed_F",
                "Land_FuelStation_01_pump_F",
                "Land_FuelStation_02_pump_F",
                "Land_FuelStation_03_pump_F",
                "Land_A_FuelStation_Feed",
                "Land_Ind_FuelStation_Feed_EP1",
                "Land_Fuelstation"
            };
        };
    };
};

// ============================================================================
// RHD FUNCTIONS
// ============================================================================
class CfgFunctions
{
    class RHD
    {
        tag = "RHD";

        class Core
        {
            file = "core";
            class init {preInit = 1;};
            class initPlayer {};
            class initActions {};
            class savePlayer {server = 1;};
            class loadPlayer {server = 1;};
            class getItemCount {server = 1;};
            class addItem {server = 1;};
            class removeItem {server = 1;};
            class addCash {server = 1;};
            class removeCash {server = 1;};
            class notify {};
        };

        class Economy
        {
            file = "core\\economy";
            class serverBuy {server = 1;};
            class serverSell {server = 1;};
            class shopOpen {};
            class getShopPrice {};
            class getShopCatalog {};
