/*
    RHD LIFE CORE - MISSION CONFIGURATION
    ---------------------------------------------------------------------------
    This file tells Arma 3 which scripts, remote functions and UI classes
    belong to the RHD mission.

    BEGINNER EDITORS:
    - You normally do NOT need to edit this file.
    - Edit server gameplay values in: core/fn_init.sqf
    - Edit map locations in: Eden Editor (3DEN)
    - Edit dependency information in: STEAM_WORKSHOP_DEPENDENCIES.md

    ADVANCED DEVELOPERS:
    - CfgFunctions registers SQF functions.
    - CfgRemoteExec controls which networked functions may be called.
    - cTab UI definitions are included from core/ui/ctab.hpp.
    ---------------------------------------------------------------------------
*/

// ============================================================================
// BASIC MISSION INFORMATION
// ============================================================================
author = "RHD Development";
class Header
{
    gameType = Coop;
    minPlayers = 1;
    maxPlayers = 64;
};

respawn = 3;
respawnOnStart = -1;
respawnDelay = 5;
respawnTemplates[] = {"MenuPosition"};
joinUnassigned = 1;

// ============================================================================
// RHD FUNCTION REGISTRATION
// ============================================================================
class CfgFunctions
{
    class RHD
    {
        tag = "RHD";

        // Core player/server systems.
        class Core
        {
            file = "core";
            class init {preInit = 1;};
            class initPlayer {postInit = 1;};
            class initActions {};
            class savePlayer {server = 1;};
            class loadPlayer {server = 1;};
            class getItemCount {server = 1;};
            class addItem {server = 1;};
            class removeItem {server = 1;};
            class addCash {server = 1;};
            class removeCash {server = 1;};
            class notify {};
        };

        // Economy and shop.
        class Economy
        {
            file = "core\\economy";
            class serverBuy {server = 1;};
            class serverSell {server = 1;};
            class shopOpen {};
        };

        // Bank and ATM functions.
        class Bank
        {
            file = "core\\bank";
            class deposit {server = 1;};
            class withdraw {server = 1;};
            class requestDeposit {};
            class requestWithdraw {};
        };

        // Jobs and work.
        class Jobs
        {
            file = "core\\jobs";
            class setJob {server = 1;};
            class startWork {};
            class stopWork {};
        };

        // Farming, mining and refining.
        class Industry
        {
            file = "core\\industry";
            class serverGather {server = 1;};
            class requestGather {};
            class refine {server = 1;};
            class requestRefine {};
        };

        // Police, EMS and civilian role-play systems.
        class RP
        {
            file = "core\\rp";
            class ticket {server = 1;};
            class requestTicket {};
            class heal {server = 1;};
            class requestHeal {};
            class dispatch {server = 1;};
            class receiveDispatch {};
        };

        // Fuel/services.
        class Services
        {
            file = "core\\services";
            class requestRefuel {};
            class refuel {server = 1;};
        };

        // Player UI and cTab integration.
        class UI
        {
            file = "core\\ui";
            class openMenu {};
            class keyHandler {};
            class refresh {};
            class requestBuy {};
            class requestSell {};
            class setTheme {};
            class initHud {};
            class ctabOpen {};
            class ctabBuild {};
            class ctabPage {};
            class ctabClear {};
            class ctabClose {};
        };

        // Administrator functions.
        class Admin
        {
            file = "core\\admin";
            class isAdmin {};
            class adminOpenMenu {};
            class adminExecuteFromMenu {};
            class execute {server = 1;};
            class adminFreeze {};
            class adminSpectate {};
        };

        // Optional ACE3 integration.
        class ACE
        {
            file = "core\\ace";
            class aceInit {};
        };

        // Ambient civilians, traffic and events.
        class Ambient
        {
            file = "core\\ambient";
            class director {server = 1;};
            class events {server = 1;};
        };
    };
};

// ============================================================================
// NETWORK SECURITY
// ============================================================================
// mode = 2 means only functions listed here are permitted through remoteExec.
// Server-side functions use allowedTargets = 2.
// Client-side UI functions use allowedTargets = 1.
class CfgRemoteExec
{
    class Functions
    {
        mode = 2;
        jip = 1;

        // Notifications / player UI.
        class RHD_fnc_notify {allowedTargets = 0;};
        class RHD_fnc_openMenu {allowedTargets = 1;};
        class RHD_fnc_shopOpen {allowedTargets = 1;};

        // Economy.
        class RHD_fnc_serverBuy {allowedTargets = 2;};
        class RHD_fnc_serverSell {allowedTargets = 2;};
        class RHD_fnc_setJob {allowedTargets = 2;};

        // Industry.
        class RHD_fnc_serverGather {allowedTargets = 2;};
        class RHD_fnc_refine {allowedTargets = 2;};

        // Role-play.
        class RHD_fnc_ticket {allowedTargets = 2;};
        class RHD_fnc_heal {allowedTargets = 2;};

        // Bank/services.
        class RHD_fnc_deposit {allowedTargets = 2;};
        class RHD_fnc_withdraw {allowedTargets = 2;};
        class RHD_fnc_receiveDispatch {allowedTargets = 1;};
        class RHD_fnc_refuel {allowedTargets = 2;};

        // Admin. These are still validated by Steam64 UID on the server.
        class RHD_fnc_adminOpenMenu {allowedTargets = 1;};
        class RHD_fnc_execute {allowedTargets = 2;};
        class RHD_fnc_adminFreeze {allowedTargets = 1;};
        class RHD_fnc_adminSpectate {allowedTargets = 1;};
    };
};

// ============================================================================
// cTab TABLET UI
// ============================================================================
// The actual RHD page definitions live in core/ui/ctab.hpp so UI work is kept
// separate from this mission configuration file.
#include "core\\ui\\ctab.hpp"

// ============================================================================
// RHD STATUS HUD
// ============================================================================
class RscTitles
{
    class RHD_HUD
    {
        idd = -1;
        movingEnable = 0;
        duration = 1e+011;
        fadeIn = 0;
        fadeOut = 0;
        onLoad = "uiNamespace setVariable ['RHD_HUD_DISPLAY', _this select 0]";

        class controls
        {
            class Status:RscStructuredText
            {
                idc = 7901;
                x = .015 * safezoneW + safezoneX;
                y = .955 * safezoneH + safezoneY;
                w = .97 * safezoneW;
                h = .025 * safezoneH;
                text = "RHD LIFE";
                sizeEx = .018;
                shadow = 1;
                colorBackground[] = {0,0,0,.25};
            };
        };
    };
};

// ============================================================================
// ADMIN PANEL
// ============================================================================
// This interface intentionally remains separate from the player cTab tablet.
// Admin access is provided by ACE Self Actions and is UID-gated.
// The compact player/action layout is adapted from XEAT_AdminTool.
