author = "RHD Development";
class Header
{
    gameType = Coop;
    minPlayers = 1;
    maxPlayers = 64;
};

respawn = 3;
respawnOnStart = -1;
respawnDelay = 5;
respawnTemplates[] = {"MenuPosition"};

joinUnassigned = 1;
disableChannels[] = {0};

class CfgFunctions
{
    class RHD
    {
        tag = "RHD";
        class Core
        {
            file = "core";
            class init {preInit = 1;};
            class initPlayer {postInit = 1;};
            class savePlayer {server = 1;};
            class loadPlayer {server = 1;};
            class getItemCount {};
            class addItem {};
            class removeItem {};
            class addCash {server = 1;};
            class removeCash {server = 1;};
            class notify {};
        };
        class Economy
        {
            file = "core\\economy";
            class buy {server = 1;};
            class sell {server = 1;};
            class shopOpen {};
        };
        class Jobs
        {
            file = "core\\jobs";
            class setJob {server = 1;};
            class startWork {};
            class stopWork {};
        };
        class Industry
        {
            file = "core\\industry";
            class gather {};
            class refine {server = 1;};
        };
        class UI
        {
            file = "core\\ui";
            class openMenu {};
            class keyHandler {};
            class refresh {};
        };
    };
};

class CfgRemoteExec
{
    class Functions
    {
        mode = 2;
        jip = 1;
        class RHD_fnc_notify {allowedTargets = 0;};
        class RHD_fnc_openMenu {allowedTargets = 1;};
        class RHD_fnc_shopOpen {allowedTargets = 1;};
    };
};

class CfgDebriefing
{
    class End1
    {
        title = "RHD Life";
        subtitle = "Session complete";
        description = "Thank you for playing RHD Life.";
    };
};

class RscTitles
{
    class RHD_HUD
    {
        idd = 7800;
        movingEnable = 0;
        duration = 1e10;
        fadein = 0;
        fadeout = 0;
        onLoad = "uiNamespace setVariable ['RHD_HUD', _this select 0]";
        class controls
        {
            class Info: RscText
            {
                idc = 7801;
                x = 0.72 * safezoneW + safezoneX;
                y = 0.04 * safezoneH + safezoneY;
                w = 0.24 * safezoneW;
                h = 0.10 * safezoneH;
                sizeEx = 0.022;
                text = "RHD LIFE";
            };
        };
    };
};

